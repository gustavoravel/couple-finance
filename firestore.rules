rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isMember(hid) {
      return request.auth != null &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    match /inviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    match /households/{hid} {
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.members;
      allow read: if isMember(hid) || (isAuthenticated() && resource.data.members.size() < 2);
      allow update: if isMember(hid) || (
        isAuthenticated() &&
        request.auth.uid in request.resource.data.members &&
        !(request.auth.uid in resource.data.members) &&
        resource.data.members.size() < 2
      );

      match /{subcollection}/{docId} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
